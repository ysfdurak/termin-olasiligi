# Termin Olasılığı sunucu ayarları (kopyala: cp .env.example .env)
# Sunucu veri saklamaz; burada gizli anahtar yok.
PORT=8080
# MCP kapısı (Claude bağlantısı): 0 yazılırsa kapanır
MCP_ACIK=1
# Tarayıcıdan /mcp isteğine izin verilen kaynaklar (virgülle). Claude sunucudan çağırır, Origin göndermez.
IZINLI_KAYNAKLAR=https://termin.ysfdurak.com
# IP başına dakikalık sınırlar
MCP_DAKIKADA=60
SAYFA_DAKIKADA=600
